<%- include("../partials/head", { pageTitle }) %>
<%- include("../partials/nav", { activeTab }) %>

<main class="content">
  <a class="back-link" href="/admin">← Back to admin</a>

  <header class="page-header">
    <h1>New update</h1>
    <p class="muted">Post one clean update that everyone can read.</p>
  </header>

  <% if (typeof error !== "undefined") { %>
    <div class="alert alert-bad"><%= error %></div>
  <% } %>

  <section class="card">
    <form method="post" action="/admin/updates" class="form">
      <div class="form-row">
        <label>Title</label>
        <input class="input inset" name="title" value="<%= (form && form.title) || '' %>" placeholder="Today’s update…" />
      </div>
      <div class="form-row">
        <label>Update text</label>
        <textarea class="input inset" name="body" rows="10" placeholder="Write the update…"><%= (form && form.body) || '' %></textarea>
      </div>
      <button class="btn btn-primary" type="submit">Publish</button>
    </form>
  </section>
</main>

<%- include("../partials/footer") %>
