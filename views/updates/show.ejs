<%- include("../partials/head", { pageTitle }) %>
  <%- include("../partials/nav", { activeTab }) %>

    <main class="content">
      <a class="back-link" href="/updates">← Back</a>

      <% if (error) { %>
        <div class="alert alert-bad">
          <%= error %>
        </div>
        <% } %>

          <article class="card">
            <div class="card-top">
              <h1 class="card-title">
                <%= update.title %>
              </h1>
              <time class="tiny muted js-local-time" data-local-time="<%= new Date(update.created_at).toISOString() %>">
                <%= new Date(update.created_at).toLocaleString() %>
              </time>
            </div>

            <div class="prose preline">
              <%= update.body || "" %>
            </div>
          </article>

          <% if (images && images.length) { %>
            <section class="gallery-grid update-gallery" style="margin-top:16px;">
              <% images.forEach((img, index)=> { %>
                <figure class="card gallery-card">
                  <img class="gallery-img" src="<%= img.public_url %>" alt="<%= update.title || 'Update photo' %>"
                    loading="lazy" data-lightbox="true" data-index="<%= index %>" data-title="<%= update.title || '' %>"
                    data-caption="<%= img.caption || '' %>" />
                </figure>
                <% }) %>
            </section>
            <% } %>

              <% if (isAdmin) { %>
                <div class="admin-actions" style="margin-top:12px;">
                  <a class="btn btn-soft" href="/admin/updates/<%= update.id %>/edit">Edit update</a>
                  <form method="post" action="/admin/updates/<%= update.id %>/delete" style="margin:0;"
                    onsubmit="return confirm('Delete this update and all its questions?');">
                    <button class="btn btn-soft" type="submit">Delete</button>
                  </form>
                </div>
                <% } %>

                  <section class="stack" id="questions">
                    <div class="section-head">
                      <h2>Questions</h2>
                      <span class="pill">
                        <%= questions.length %>
                      </span>
                    </div>

                    <% if (!questions || questions.length===0) { %>
                      <div class="card">
                        <p class="muted">No questions yet.</p>
                      </div>
                      <% } else { %>
                        <% questions.forEach(q=> { %>
                          <div class="card">
                            <div class="q-head">
                              <div>
                                <div class="tiny muted">
                                  <%= q.asker_name ? q.asker_name : "Anonymous" %>
                                    •
                                    <time class="js-local-time"
                                      data-local-time="<%= new Date(q.asked_at).toISOString() %>">
                                      <%= new Date(q.asked_at).toLocaleString() %>
                                    </time>
                                </div>
                                <div class="q-text preline">
                                  <%= q.question %>
                                </div>
                              </div>
                            </div>

                            <% if (isAdmin) { %>
                              <div class="admin-actions" style="margin-top:10px;">
                                <a class="btn btn-soft" href="/admin/questions/<%= q.id %>/edit">Edit</a>
                                <form method="post" action="/admin/questions/<%= q.id %>/delete" style="margin:0;"
                                  onsubmit="return confirm('Delete this question?');">
                                  <button class="btn btn-soft" type="submit">Delete</button>
                                </form>
                              </div>
                              <% } %>

                                <% if (q.answer) { %>
                                  <div class="answer">
                                    <div class="answer-label">Answer</div>
                                    <div class="preline">
                                      <%= q.answer %>
                                    </div>
                                    <div class="tiny muted">
                                      <% if (q.answered_at) { %>
                                        <time class="js-local-time"
                                          data-local-time="<%= new Date(q.answered_at).toISOString() %>">
                                          <%= new Date(q.answered_at).toLocaleString() %>
                                        </time>
                                        <% } %>
                                    </div>
                                  </div>
                                  <% } else { %>
                                    <div class="tiny muted">Awaiting reply.</div>
                                    <% } %>
                          </div>
                          <% }) %>
                            <% } %>
                  </section>

                  <details class="card collapse" id="ask">
                    <summary class="collapse-summary">
                      <div class="collapse-title">
                        Ask a question
                        <span class="collapse-sub muted">Tap to open</span>
                      </div>
                      <span class="collapse-chevron" aria-hidden="true">⌄</span>
                    </summary>

                    <div class="collapse-anim" aria-hidden="false">
                      <div class="collapse-anim-inner">
                        <div class="collapse-body">
                          <p class="muted">Your question stays attached to this update, so everyone can see the reply.
                          </p>

                          <form method="post" action="/updates/<%= update.id %>/questions" class="form">
                            <div class="form-row">
                              <label>Name (optional)</label>
                              <input class="input inset" name="asker_name" placeholder="Your name" />
                            </div>
                            <div class="form-row">
                              <label>Contact (optional)</label>
                              <input class="input inset" name="asker_contact" placeholder="Email or phone (optional)" />
                            </div>
                            <div class="form-row">
                              <label>Question</label>
                              <textarea class="input inset" name="question" rows="4"
                                placeholder="Type your question…"></textarea>
                            </div>
                            <button class="btn btn-primary" type="submit">Post question</button>
                          </form>
                        </div>
                      </div>
                    </div>
                  </details>
    </main>

    <!-- MINIMAL LIGHTBOX (same functionality, cleaner look) -->
    <div class="lightbox" id="lightbox" aria-hidden="true">
      <div class="lightbox-overlay" data-action="close"></div>

      <div class="lightbox-dialog" role="dialog" aria-modal="true" aria-label="Image preview">
        <button class="lightbox-close" type="button" data-action="close" aria-label="Close image">
          <span aria-hidden="true">×</span>
        </button>

        <button class="lightbox-arrow lightbox-prev" type="button" data-action="prev" aria-label="Previous image">
          <span aria-hidden="true">‹</span>
        </button>

        <img class="lightbox-img" alt="" />

        <button class="lightbox-arrow lightbox-next" type="button" data-action="next" aria-label="Next image">
          <span aria-hidden="true">›</span>
        </button>

        <div class="lightbox-captionbar" aria-hidden="true">
          <div class="lightbox-title"></div>
          <div class="lightbox-caption"></div>
        </div>

        <div class="lightbox-counter" aria-hidden="true"></div>
      </div>
    </div>

    <script src="/js/gallery.js"></script>
    <%- include("../partials/footer") %>