<% const items=[ { key: "updates" , label: "Updates" , href: "/updates" , icon: "stethoscope" }, { key: "contact" ,
  label: "Contact" , href: "/contact" , icon: "mail" }, { key: "support" , label: "Support" , href: "/support" ,
  icon: "handheart" }, { key: "gallery" , label: "Gallery" , href: "/gallery" , icon: "image" }, ]; function
  iconSvg(name) { const
  common='viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"'
  ; const icons={ stethoscope: `<svg ${common}>
  <path d="M6 3v4a4 4 0 0 0 8 0V3" />
  <path d="M14 7a4 4 0 0 0 8 0V6" />
  <path d="M10 11v2a6 6 0 0 0 12 0v-1" />
  <circle cx="20" cy="5.5" r="1.5" /></svg>`,
  mail: `<svg ${common}>
    <path d="M4 6h16v12H4z" />
    <path d="m4 7 8 6 8-6" />
  </svg>`,
  handheart: `<svg ${common}>
    <path d="M8 12V9a2 2 0 0 1 4 0v3" />
    <path d="M12 12V9a2 2 0 0 1 4 0v4" />
    <path d="M16 13.5c0 3-2 5.5-6 7-4-1.5-6-4-6-6.5 0-1.4.8-2.6 2-3.2" />
    <path d="M12 7.2c1.2-1.4 3.2-1.4 4.4 0 1.2 1.4.8 3.2-.3 4.2" />
  </svg>`,
  image: `<svg ${common}>
    <rect x="3" y="5" width="18" height="14" rx="3" />
    <path d="m7 15 3-3 4 4 3-3 3 3" />
    <circle cx="9" cy="10" r="1" />
  </svg>`,
  };

  return icons[name] || icons.image;
  }
  %>

  <!-- Mobile-only top bar (separate from the bottom nav) -->
  <!-- <header class="mobile-topbar">
    <div class="mobile-topbar-inner">
      <div class="mobile-topbar-title">Checking on Ryan</div>
      <div class="mobile-topbar-sub">Latest updates and questions</div>
    </div>
  </header> -->

  <nav class="nav">
    <div class="nav-inner">
      <div class="brand">
        <div class="brand-dot"></div>
        <div class="brand-text">
          <div class="brand-title">The Ryan Daily</div>
          <!-- <div class="brand-sub">All in one place</div> -->
        </div>
      </div>

      <div class="nav-links">
        <% items.forEach(i=> { const active = (activeTab === i.key); %>
          <a class="nav-link <%= active ? 'is-active' : '' %>" href="<%= i.href %>"
            aria-current="<%= active ? 'page' : 'false' %>">
            <span class="nav-ic"><%- iconSvg(i.icon) %></span>
            <span class="nav-label">
              <%= i.label %>
            </span>
          </a>
          <% }); %>
      </div>

      <% if (isAdmin) { %>
        <form action="/admin/logout" method="post" class="admin-logout">
          <button class="btn btn-soft" type="submit">Log out</button>
        </form>
        <% } else { %>
          <a class="btn btn-soft" href="/admin/login">Admin</a>
          <% } %>
    </div>
  </nav>